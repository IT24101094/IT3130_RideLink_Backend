# ==============================================================================
# RideLink Ride Management Service - Environment Configuration Template
# ==============================================================================

# Server Configuration
SERVER_PORT=8083

# Application Name
SPRING_APPLICATION_NAME=ride-management-service

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/ride_db
MONGODB_URI=mongodb://localhost:27017/ride_db

# Eureka Service Discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/

# Downstream Microservices URLs (OpenFeign)
ACCOUNT_SERVICE_URL=http://localhost:8081
DRIVER_SERVICE_URL=http://localhost:8082
FARE_PAYMENT_SERVICE_URL=http://localhost:8084
