# ==============================================================================
# RideLink Microservices Ecosystem - Environment Reference Template
# ==============================================================================
#
# Default Port & Service Matrix:
# ------------------------------------------------------------------------------
# 1. eureka-server           Port: 8761  URL: http://localhost:8761/eureka/
# 2. api-gateway             Port: 8080  Routes: /api/passengers/**, /api/accounts/**,
#                                                /api/drivers/**, /api/vehicles/**,
#                                                /api/rides/**, /api/fares/**, /api/payments/**
# 3. account-service         Port: 8081  DB: account_db
# 4. driver-vehicle-service  Port: 8082  DB: driver_db
# 5. ride-management-service Port: 8083  DB: ride_db
# 6. fare-payment-service    Port: 8084  DB: fare_payment_db
# ==============================================================================

# Central Eureka Service Registry
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/

# Service Ports
EUREKA_SERVER_PORT=8761
API_GATEWAY_PORT=8080
ACCOUNT_SERVICE_PORT=8081
DRIVER_VEHICLE_SERVICE_PORT=8082
RIDE_MANAGEMENT_SERVICE_PORT=8083
FARE_PAYMENT_SERVICE_PORT=8084

# MongoDB Default Local URIs
ACCOUNT_SERVICE_MONGO_URI=mongodb://localhost:27017/account_db
DRIVER_SERVICE_MONGO_URI=mongodb://localhost:27017/driver_db
RIDE_SERVICE_MONGO_URI=mongodb://localhost:27017/ride_db
FARE_PAYMENT_MONGO_URI=mongodb://localhost:27017/fare_payment_db

# Microservice Inter-communication URLs
ACCOUNT_SERVICE_URL=http://localhost:8081
DRIVER_SERVICE_URL=http://localhost:8082
FARE_PAYMENT_SERVICE_URL=http://localhost:8084
